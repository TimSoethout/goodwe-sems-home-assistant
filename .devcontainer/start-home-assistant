#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
core_dir="${HA_CORE_DIR:-"$repo_root/.ha-core"}"
python="$core_dir/.venv/bin/python"
pid_file="/tmp/home-assistant.pid"
ha_pid=""
onboarding_pid=""

terminate_running_instance() {
  local pid
  if [[ ! -f "$pid_file" ]]; then
    echo "Home Assistant is not running." >&2
    return 0
  fi
  pid="$(cat "$pid_file")"
  if ! ha_pid_is_running "$pid"; then
    rm -f "$pid_file"
    echo "Home Assistant is not running." >&2
    return 0
  fi
  echo "Stopping Home Assistant (PID $pid)..."
  kill -TERM "$pid" 2>/dev/null || true
  for _ in {1..60}; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  rm -f "$pid_file"
  echo "Home Assistant stopped."
}

ha_pid_is_running() {
  local pid="$1"
  local -a process_args
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [[ -r "/proc/$pid/cmdline" ]] || return 1
  mapfile -d '' -t process_args <"/proc/$pid/cmdline"
  [[ "${process_args[*]}" == *"-m homeassistant -c config"* ]]
}

if [[ ! -x "$python" ]]; then
  echo "Home Assistant is not set up. Run .devcontainer/setup.sh first." >&2
  exit 1
fi

if [[ $# -gt 1 || ( "${1:-}" != "" && "${1:-}" != "--foreground" && "${1:-}" != "--terminate" && "${1:-}" != "--restart" ) ]]; then
  echo "Usage: bash .devcontainer/start-home-assistant [--foreground|--terminate|--restart]" >&2
  exit 2
fi

case "${1:-}" in
  --terminate)
    terminate_running_instance
    exit 0
    ;;
  --restart)
    terminate_running_instance
    ;;
esac

if [[ -f "$pid_file" ]]; then
  existing_pid="$(cat "$pid_file")"
  if ha_pid_is_running "$existing_pid"; then
    echo "Home Assistant is already running (PID $existing_pid)." >&2
    echo "Terminate the existing run task before starting another." >&2
    exit 1
  fi
  rm -f "$pid_file"
fi

cleanup() {
  local child_pid
  trap - EXIT INT TERM
  for child_pid in "$onboarding_pid" "$ha_pid"; do
    if [[ "$child_pid" =~ ^[0-9]+$ ]] && kill -0 "$child_pid" 2>/dev/null; then
      kill -TERM "$child_pid" 2>/dev/null || true
    fi
  done
  for child_pid in "$onboarding_pid" "$ha_pid"; do
    if [[ "$child_pid" =~ ^[0-9]+$ ]]; then
      wait "$child_pid" 2>/dev/null || true
    fi
  done
  rm -f "$pid_file"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

echo "Home Assistant is starting at http://localhost:8123"
cd "$core_dir"
"$python" -m homeassistant -c config &
ha_pid="$!"
printf '%s\n' "$ha_pid" >"$pid_file"

"$python" "$repo_root/.devcontainer/onboard-home-assistant.py" "$core_dir" &
onboarding_pid="$!"
if ! wait "$onboarding_pid"; then
  echo "Home Assistant onboarding failed; complete onboarding in the UI." >&2
fi
onboarding_pid=""

wait "$ha_pid"
