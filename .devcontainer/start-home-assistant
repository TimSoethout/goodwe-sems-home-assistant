#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
core_dir="${HA_CORE_DIR:-"$repo_root/.ha-core"}"
python="$core_dir/.venv/bin/python"
pid_file="/tmp/home-assistant.pid"
log_file="/tmp/home-assistant.log"

if [[ ! -x "$python" ]]; then
  echo "Home Assistant is not set up. Run .devcontainer/setup.sh first." >&2
  exit 1
fi

if [[ -f "$pid_file" ]] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
  echo "Home Assistant is already running"
else
  (
    cd "$core_dir"
    nohup "$python" -m homeassistant -c config >"$log_file" 2>&1 &
    echo $! >"$pid_file"
  )

  echo "Home Assistant is starting at http://localhost:8123"
fi

echo "Logs: $log_file"

uv run --no-project --python "$python" \
  "$repo_root/.devcontainer/onboard-home-assistant.py" "$core_dir"
